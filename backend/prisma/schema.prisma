// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  ADMIN
  ACCOUNTANT
}

// Staff accounts (Admin / Accountant). Created by an Admin through the
// Create User page - never through public self-signup. See plan.md
// Module 3 for the full auth model.
model User {
  id                  String    @id @default(cuid())
  name                String
  loginId             String    @unique
  email               String    @unique
  passwordHash        String
  role                StaffRole
  isActive            Boolean   @default(true)
  resetToken          String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("users")
}

enum AccountType {
  ASSET
  LIABILITY
  EXPENSE
  INCOME
  CAPITAL
}

// Chart of Accounts - the master list of ledger accounts (Cash, Bank,
// Sales Income, Purchase Expense, ...) that every transaction gets
// classified under. See plan.md Module 4.
model Account {
  id        String      @id @default(cuid())
  name      String
  type      AccountType
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  journals     Journal[]
  journalItems JournalItem[]

  @@index([type])
  @@map("accounts")
}

enum JournalType {
  SALES
  PURCHASE
  BANK
  CASH
}

// A Journal groups similar transactions (all sales, all purchases, all
// bank activity, ...) and points at the Account that new entries default
// to. See plan.md Module 7. onDelete: Restrict on defaultAccountId means
// an Account can't be deleted while a Journal still points at it.
model Journal {
  id               String         @id @default(cuid())
  name             String
  type             JournalType
  defaultAccountId String
  defaultAccount   Account        @relation(fields: [defaultAccountId], references: [id], onDelete: Restrict)
  entries          JournalEntry[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([defaultAccountId])
  @@map("journals")
}

// The actual accounting record for one transaction - which Journal it
// belongs to, when, and a reference. The debit/credit lines themselves
// live on JournalItem below. See plan.md Module 8.
model JournalEntry {
  id        String        @id @default(cuid())
  journalId String
  journal   Journal       @relation(fields: [journalId], references: [id], onDelete: Restrict)
  date      DateTime
  reference String
  items     JournalItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([journalId])
  @@map("journal_entries")
}

// One debit or credit line within a JournalEntry. onDelete: Cascade on
// journalEntryId means deleting an entry deletes its lines too; onDelete:
// Restrict on accountId means an Account can't be deleted while any
// JournalItem still references it (same reasoning as Journal.defaultAccountId).
model JournalItem {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit          Decimal      @default(0) @db.Decimal(10, 2)
  credit         Decimal      @default(0) @db.Decimal(10, 2)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_items")
}

enum ProductType {
  GOODS
  SERVICE
  COMBO
}

// Products/services Urban Furniture buys or sells (Office Chair, Wooden
// Table, ...). See plan.md Module 5.
model Product {
  id                   String                @id @default(cuid())
  name                 String
  type                 ProductType
  salesPrice           Decimal               @db.Decimal(10, 2)
  costPrice            Decimal               @db.Decimal(10, 2)
  category             String
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  purchaseOrderItems   PurchaseOrderItem[]
  salesOrderItems      SalesOrderItem[]

  @@map("products")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  BILLED
  CANCELLED
}

enum DocStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentType {
  PAYMENT
  REFUND
}

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
  CARD
  ONLINE
}

enum ContactType {
  CUSTOMER
  VENDOR
  BOTH
}

// Customers and vendors. Unlike User (staff), a Contact is never created
// via public self-signup - an Admin/Accountant creates the record here,
// which triggers an activation email so the Contact can set their own
// password and log in to the portal. See plan.md Module 6.
model Contact {
  id                       String            @id @default(cuid())
  name                     String
  type                     ContactType
  email                    String            @unique
  mobile                   String
  city                     String
  state                    String
  pincode                  String
  // Just a path/URL to an uploaded file (e.g. "/uploads/<name>.jpg"), not
  // the image itself - see POST /uploads and profileImageSchema.
  profileImage             String?
  passwordHash             String? // null until the Contact activates their account
  isActivated              Boolean           @default(false)
  activationToken          String?
  activationTokenExpiresAt DateTime?
  resetToken               String?
  resetTokenExpiresAt      DateTime?
  isActive                 Boolean           @default(true)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  purchaseOrders           PurchaseOrder[]
  vendorBills              VendorBill[]
  salesOrders              SalesOrder[]
  customerInvoices         CustomerInvoice[]

  @@index([type])
  @@map("contacts")
}

model PurchaseOrder {
  id        String              @id @default(cuid())
  poNumber  String              @unique
  vendorId  String
  vendor    Contact             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  date      DateTime
  status    OrderStatus         @default(DRAFT)
  items     PurchaseOrderItem[]
  bill      VendorBill?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity        Int
  unitPrice       Decimal       @db.Decimal(10, 2)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model VendorBill {
  id              String        @id @default(cuid())
  billNumber      String        @unique
  purchaseOrderId String        @unique
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  vendorId        String
  vendor          Contact       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  invoiceDate     DateTime
  dueDate         DateTime
  totalAmount     Decimal       @db.Decimal(10, 2)
  status          DocStatus     @default(UNPAID)
  payments        Payment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([vendorId])
  @@index([status])
  @@map("vendor_bills")
}

model SalesOrder {
  id        String           @id @default(cuid())
  soNumber  String           @unique
  customerId String
  customer  Contact          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  date      DateTime
  status    OrderStatus      @default(DRAFT)
  items     SalesOrderItem[]
  invoice   CustomerInvoice?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([customerId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int
  unitPrice    Decimal    @db.Decimal(10, 2)
  tax          Decimal    @db.Decimal(10, 2) @default(0)

  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_items")
}

model CustomerInvoice {
  id            String      @id @default(cuid())
  invoiceNumber String      @unique
  salesOrderId  String      @unique
  salesOrder    SalesOrder  @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  customerId    String
  customer      Contact     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceDate   DateTime
  dueDate       DateTime
  totalAmount   Decimal     @db.Decimal(10, 2)
  status        DocStatus   @default(UNPAID)
  emailSentAt   DateTime?
  payments      Payment[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("customer_invoices")
}

model Payment {
  id                String           @id @default(cuid())
  type              PaymentType
  method            PaymentMethod
  amount            Decimal          @db.Decimal(10, 2)
  date              DateTime
  vendorBillId      String?
  vendorBill        VendorBill?      @relation(fields: [vendorBillId], references: [id], onDelete: Restrict)
  customerInvoiceId String?
  customerInvoice   CustomerInvoice? @relation(fields: [customerInvoiceId], references: [id], onDelete: Restrict)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([vendorBillId])
  @@index([customerInvoiceId])
  @@map("payments")
}
